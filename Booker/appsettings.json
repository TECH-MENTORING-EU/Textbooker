{
  "ConnectionStrings": {
    "DefaultConnection": "{#db-connection-string#}",
    "BookerIdentityDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=Booker;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "testingPhase": false,
  "Features": {
    "MessagesEnabled": false,
    "ProfilePhotosEnabled": false,
    "DefaultProfilePicturePath": "/img/default-profile-picture.jpg"
  },
  "Maintenance": false,
  "ContactRevealLimits": {
    "PerHour": 100,
    "PerDay": 600
  },
  "AdminLockout": {
    "MaxDurationDays": 3650
  },
  "DatabaseSettings": {
    "ClearDatabaseOnStartup": false
  },
  "AzureStorage": {
    "ConnectionString": "{#storage-connection-string#}",
    "ContainerName": "{#container-name#}"
  },
  "CF": {
    "AccountId": "{#cloudflare-account-id#}",
    "ServiceUrl": "{#cloudflare-r2-service-url#}",
    "PublicUrl": "{#cloudflare-r2-public-url#}"
  },
  "S3": {
    "AccessKeyId": "{#cloudflare-r2-access-key-id#}",
    "SecretAccessKey": "{#cloudflare-r2-secret-access-key#}",
    "BucketName": "{#cloudflare-r2-bucket-name#}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Trace"
    }
  },
  "SmtpSettings": {
    "Server": "smtp.webio.pl",
    "Port": 587,
    "EnableSsl": true,
    "Username": "{smtp-username}",
    "Password": "#{smtp-password}#"
  },
  "SassCompiler": {
    "Source": "wwwroot/scss",
    "IncludePaths": [
      "wwwroot/lib/pico/scss"
    ],
    "Arguments": "--style=compressed --no-source-map",
    "Configurations": {
      "Debug": {
        "Arguments": "--style=expanded"
      }
    }
  },
  "AllowedHosts": "*"
}