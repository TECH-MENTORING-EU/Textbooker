<ul role="list" aria-label="Sekcje panelu administracyjnego">
    @{
        var indexCurrent = AdminNavPages.IndexNavClass(ViewContext);
        var usersCurrent = AdminNavPages.UsersNavClass(ViewContext);
        var adminsCurrent = AdminNavPages.AdminsNavClass(ViewContext);
        var schoolsCurrent = AdminNavPages.SchoolsNavClass(ViewContext);
    }
    <li><a aria-current="@(string.IsNullOrEmpty(indexCurrent) ? null : indexCurrent)" id="summary" asp-page="./Index">Podsumowanie</a></li>
    <li><a aria-current="@(string.IsNullOrEmpty(usersCurrent) ? null : usersCurrent)" id="users" asp-page="./Users">Użytkownicy</a></li>
    <li><a aria-current="@(string.IsNullOrEmpty(adminsCurrent) ? null : adminsCurrent)" id="admins" asp-page="./Admins">Administratorzy</a></li>
    <li><a aria-current="@(string.IsNullOrEmpty(schoolsCurrent) ? null : schoolsCurrent)" id="schools" asp-page="./Schools">Szkoły</a></li>
</ul>
