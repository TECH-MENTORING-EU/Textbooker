@page
@model SchoolsModel
@{
    ViewData["Title"] = "Szkoły - TextBooker";
    ViewData["ActivePage"] = AdminNavPages.Schools;
}

<h3>Zarządzanie szkołami</h3>

<div class="admin-filter">
    <label for="show-inactive">
        <input type="checkbox" 
               id="show-inactive"
               hx-get="?handler=Filter"
               hx-target="#schools-table tbody"
               hx-include="this"
               name="showInactive"
               value="true"
               @(Model.ShowInactive ? "checked" : "") />
        Pokaż nieaktywne szkoły
    </label>
</div>

<p class="table-scroll-hint" id="schools-table-hint">Przewiń tabelę poziomo, aby zobaczyć wszystkie kolumny.</p>
<div class="table-scroll" role="region" aria-label="Tabela szkół" aria-describedby="schools-table-hint" tabindex="0">
<table id="schools-table">
    <caption class="visually-hidden">Lista zarządzanych szkół</caption>
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nazwa</th>
            <th scope="col">Domena email</th>
            <th scope="col">Użytkownicy</th>
            <th scope="col">Status</th>
            <th scope="col">Akcje</th>
        </tr>
    </thead>
    <tbody>
        <partial name="_SchoolRows" model="Model.Schools" />
    </tbody>
</table>
</div>

<article class="school-add-form" aria-labelledby="add-school-heading">
    <header>
        <h4 id="add-school-heading">Dodaj nową szkołę</h4>
    </header>
    <form asp-page-handler="Add" method="post" hx-post="?handler=Add" hx-target="#schools-table tbody" hx-swap="beforeend" hx-on::after-request="this.reset()">
        <fieldset role="group" aria-label="Dane nowej szkoły">
            <input name="name" 
                   placeholder="Nazwa szkoły" 
                   aria-label="Nazwa szkoły" 
                   required
                   minlength="2"
                   maxlength="200" />
            <input name="emailDomain" 
                   placeholder="Domena email (opcjonalna, np. szkola.edu.pl)" 
                   aria-label="Domena email (opcjonalna)"
                   maxlength="500" />
            <button type="submit">Dodaj szkołę</button>
        </fieldset>
        <div asp-validation-summary="All" role="alert" aria-live="assertive"></div>
    </form>
</article>

@section Scripts {
    <script>
        const schoolAddForm = document.querySelector('.school-add-form form');

        schoolAddForm?.addEventListener('htmx:afterRequest', function(evt) {
            if (!evt.detail.successful) return;

            var errorDiv = this.querySelector('[data-valmsg-summary="true"]');
            if (errorDiv) errorDiv.innerHTML = '';
        });
    </script>
}
