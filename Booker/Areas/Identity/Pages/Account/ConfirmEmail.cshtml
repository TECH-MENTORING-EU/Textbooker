@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Potwierdzenie adresu e-mail";
}

<h1>@ViewData["Title"]</h1>
@if (!string.IsNullOrEmpty(Model.DisplayMessage))
{
    <div class="alert alert-warning" role="alert">
        <p>@Model.DisplayMessage</p>
    </div>
}
else
{
    <p>@Model.StatusMessage</p>
    <a asp-area="Identity" asp-page="/Account/Manage/Index" role="button">Zaloguj się i uzupełnij swój profil</a>
}
