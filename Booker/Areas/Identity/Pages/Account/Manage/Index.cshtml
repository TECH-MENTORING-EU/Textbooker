@page
@model IndexModel
@{
    ViewData["Title"] = "Ustawienia profilu";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="login-form">
    <form id="profile-form" method="post">
        <h3>@ViewData["Title"]</h3>
        @if (!String.IsNullOrEmpty(Model.StatusMessage))
        {
            <p>
                @Model.StatusMessage
            </p>
        }
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div>
            <label asp-for="Username">Nazwa użytkownika</label>
            <input asp-for="Username" placeholder="Nazwa użytkownika" disabled />
            <small>
                Aby zmienić nazwę użytkownika, skontaktuj się z administracją.
            </small>
        </div>
        <div>
            <label asp-for="Input.AreFavoritesPublic">
                <input role="switch" asp-for="Input.AreFavoritesPublic" />
                Pokaż moje ulubione innym użytkownikom
            </label>
        </div>
        <hr />
        <h4>Formy kontaktu</h4>
        <p>
            <small>
                Gdy masz opublikowane ogłoszenie, zalogowani użytkownicy zainteresowani zakupem mogą
                kliknąć przycisk kontaktu, żeby zobaczyć wybrane przez Ciebie kanały kontaktu poniżej.
                Osoby niezalogowane i osoby bez Twojego aktywnego ogłoszenia nigdy ich nie zobaczą.
                <strong>Jeśli wyłączysz tu wszystkie kanały, nikt nie będzie mógł się z Tobą skontaktować
                w sprawie ogłoszeń</strong> — dlatego musisz zostawić włączony przynajmniej jeden.
            </small>
        </p>
        <div style="margin-bottom: 1rem;">
            <label asp-for="Input.DisplayEmail">
                <input role="switch" asp-for="Input.DisplayEmail" />
                Pokaż mój e-mail jako dostępną formę kontaktu
            </label>
            <small>
                Włączone: Twój e-mail zobaczy zalogowany użytkownik po kliknięciu przycisku kontaktu przy
                Twoim ogłoszeniu. Wyłączone: nikt nie zobaczy Twojego e-maila. Swój e-mail możesz zmienić
                <a asp-page="./Email">tutaj</a>.
            </small>
        </div>
        <p>
            <small>
                Poniższe dane są całkowicie dobrowolne. Ich pokazanie innym jest Twoją zgodą, którą możesz
                wycofać w dowolnym momencie, wyłączając odpowiedni przełącznik.
            </small>
        </p>
        <div>
            <label asp-for="Input.PhoneNumber">Numer telefonu:</label>
            <input asp-for="Input.PhoneNumber" placeholder="Numer telefonu"/>
            <small>
                <span asp-validation-for="Input.PhoneNumber"></span>
            </small>
        </div>
        <div style="margin-bottom: 1rem;">
            <label asp-for="Input.DisplayPhone">
                <input role="switch" asp-for="Input.DisplayPhone" />
                Pokaż mój numer telefonu jako dostępną formę kontaktu
            </label>
        </div>
        <div style="margin-bottom: 1rem;">
            <label asp-for="Input.DisplayWhatsapp">
                <input role="switch" asp-for="Input.DisplayWhatsapp" />
                Pokaż WhatsApp jako dostępną formę kontaktu
            </label>
        </div>
        <div>
            <label asp-for="Input.FbMessenger">Messenger (nazwa użytkownika):</label>
            <input asp-for="Input.FbMessenger" placeholder="Messenger (nazwa użytkownika)" />
            <small>
                <span asp-validation-for="Input.FbMessenger"></span>
            </small>
        </div>
        <div style="margin-bottom: 1rem;">
            <label asp-for="Input.DisplayMessenger">
                <input role="switch" asp-for="Input.DisplayMessenger" />
                Pokaż Messenger jako dostępną formę kontaktu
            </label>
        </div>
        <div>
            <label asp-for="Input.Instagram">Instagram (nazwa użytkownika):</label>
            <input asp-for="Input.Instagram" placeholder="Instagram (nazwa użytkownika)" />
            <small>
                <span asp-validation-for="Input.Instagram"></span>
            </small>
        </div>
        <div style="margin-bottom: 1rem;">
            <label asp-for="Input.DisplayInstagram">
                <input role="switch" asp-for="Input.DisplayInstagram" />
                Pokaż Instagram jako dostępną formę kontaktu
            </label>
        </div>
        <button id="update-profile-button" type="submit">Zapisz</button>
    </form>
</div>

