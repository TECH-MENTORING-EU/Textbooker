@page
@model RegisterModel
@{
    ViewData["Title"] = "Rejestracja - TextBooker";
}

<h1>@ViewData["Title"]</h1>

<section class="login-form" aria-labelledby="register-heading">
    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <h2 id="register-heading">Stwórz nowe konto:</h2>
        <hr />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" aria-live="assertive"></div>
        <div>
            <label asp-for="Input.UserName">Nazwa użytkownika:</label>
            <input asp-for="Input.UserName" autocomplete="username" required placeholder="Nazwa użytkownika" aria-describedby="Input_UserName-error" />
            <small id="Input_UserName-help"><span asp-validation-for="Input.UserName" id="Input_UserName-error"></span></small>
        </div>
        <div>
            <label asp-for="Input.Email">E-mail:</label>
            <input asp-for="Input.Email"
                   autocomplete="email"
                   required
                   placeholder="E-mail"
                   aria-describedby="Input_Email-error"
                   hx-get="?handler=AutoSchool"
                   hx-trigger="blur, change"
                   hx-target="#Input_SchoolId"
                   hx-swap="innerHTML" />
            <small id="Input_Email-help"><span asp-validation-for="Input.Email" id="Input_Email-error"></span></small>
        </div>
        <div>
            <label asp-for="Input.Password">Hasło:</label>
            <input asp-for="Input.Password" autocomplete="new-password" required placeholder="Hasło"
                   aria-describedby="Input_Password-error passwordRequirements"
                   data-password-input />
            <small><span asp-validation-for="Input.Password" id="Input_Password-error"></span></small>
            <ul id="passwordRequirements" class="password-rules" aria-live="polite" aria-label="Wymagania dotyczące hasła" style="display:none; margin-top:8px;">
                <li id="req-length">&#10060; minimum 8 znaków</li>
                <li id="req-special">&#10060; minimum 1 znak specjalny</li>
                <li id="req-lower">&#10060; minimum 1 mała litera</li>
                <li id="req-upper">&#10060; minimum 1 wielka litera</li>
                <li id="req-digit">&#10060; minimum 1 cyfra</li>
            </ul>
        </div>
        <div>
            <label asp-for="Input.ConfirmPassword">Potwierdź hasło:</label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" required placeholder="Hasło" aria-describedby="Input_ConfirmPassword-error" />
            <small id="Input_ConfirmPassword-help"><span asp-validation-for="Input.ConfirmPassword" id="Input_ConfirmPassword-error"></span></small>
        </div>
        <div>
            <label asp-for="Input.SchoolId">Szkoła:</label>
            <select asp-for="Input.SchoolId"
                    asp-items="Model.AvailableSchools"
                    aria-describedby="Input_SchoolId-help">
                <option value="">Wybierz szkołę</option>
            </select>
            <small id="Input_SchoolId-help"><span asp-validation-for="Input.SchoolId"></span></small>
        </div>

        <hr />

        <div role="note" aria-label="Informacja o przetwarzaniu danych osobowych">
            <p>
                Administratorem Twoich danych osobowych jest Tomasz Osmanowski, prowadzący TextBooker.
                Dane przetwarzamy w celu założenia i prowadzenia konta oraz umożliwienia kontaktu między
                użytkownikami w sprawie ogłoszeń. <strong>Twój adres e-mail zobaczą zalogowani użytkownicy,
                którzy klikną przycisk kontaktu przy Twoim ogłoszeniu</strong> — to niezbędne, żeby ktoś mógł
                się z Tobą skontaktować w sprawie zakupu. Masz prawo dostępu do swoich danych, ich
                sprostowania oraz usunięcia.
            </p>
            <p>
                Wybranej przy rejestracji <strong>szkoły nie da się później zmienić</strong> — zmiana wymaga
                założenia nowego konta.
            </p>
            <p>
                <a asp-page="/Prywatnosc-w-skrocie" target="_blank" rel="noopener"><strong>Polityka prywatności w skrócie</strong></a>
                &nbsp;·&nbsp;
                <a asp-page="/Privacy" target="_blank" rel="noopener">Pełna polityka prywatności</a>
            </p>
        </div>

        <fieldset>
            <label for="acceptTermsCheckbox" class="form-check-label">
                <input type="checkbox" id="acceptTermsCheckbox" asp-for="Input.AcceptTerms" required>
                Przeczytałem/am i akceptuję <a asp-page="/Regulamin" target="_blank" rel="noopener">regulamin</a>.
            </label>
        </fieldset>
        <small><span asp-validation-for="Input.AcceptTerms" class="text-danger" role="alert"></span></small>

        <fieldset>
            <label for="confirmsAgeRequirementCheckbox" class="form-check-label">
                <input type="checkbox" id="confirmsAgeRequirementCheckbox" asp-for="Input.ConfirmsAgeRequirement" required>
                @Html.DisplayNameFor(m => m.Input.ConfirmsAgeRequirement)
            </label>
        </fieldset>
        <small><span asp-validation-for="Input.ConfirmsAgeRequirement" class="text-danger" role="alert"></span></small>

        <button id="registerSubmit" type="submit">Zarejestruj</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register.js" asp-append-version="true"></script>
}
