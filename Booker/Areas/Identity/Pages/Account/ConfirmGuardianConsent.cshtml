@page
@model ConfirmGuardianConsentModel
@using Booker.Utilities
@{
    ViewData["Title"] = "Potwierdzenie zgody opiekuna";
}

<h1>@ViewData["Title"]</h1>

@if (Model.CanConfirm)
{
    <div class="alert alert-info" role="alert">
        <p>@Model.Message</p>
    </div>
    <dl>
        <dt>Nazwa użytkownika ucznia</dt>
        <dd>@Model.ChildUserName</dd>
        <dt>E-mail ucznia</dt>
        <dd>@Model.ChildEmail</dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <p>Klikając przycisk poniżej, potwierdzasz jako opiekun zgodę na założenie i aktywację konta powyższego ucznia na platformie TextBooker.</p>
        <button type="submit">Potwierdzam zgodę</button>
    </form>
}
else
{
    <div class="alert alert-danger" role="alert">
        <strong>❌ Błąd potwierdzenia</strong>
        <p>@Model.Message</p>
        <p>
            Możliwe przyczyny:
            <ul>
                <li>Link wygasł (ważny przez @Model.TokenExpirationDays dni)</li>
                <li>Link został już wykorzystany</li>
                <li>Zła liczba użytkownika</li>
            </ul>
        </p>
        <p>Jeśli potrzebujesz nowego linku, skontaktuj się z supportem: <a href="mailto:@ContactInfo.SupportEmail">@ContactInfo.SupportEmail</a></p>
    </div>
}

