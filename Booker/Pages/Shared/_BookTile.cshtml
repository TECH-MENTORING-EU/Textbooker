@model Components.ItemGallery.ItemGalleryViewComponent.ItemModel

@using Microsoft.AspNetCore.Identity

@inject FavoritesManager FavoritesManager
@inject UserManager<User> UserManager

@functions {
    private string DisplayGrade(string grade)
    {
        if (string.IsNullOrEmpty(grade))
            return "Nieznana klasa";

        if (grade == "Zależnie od poziomu")
            return grade;

        return $"Klasa {grade}";
    }

    private int? _userId;
    private int UserId {get => _userId ??= UserManager.GetUserId(User).IntOrDefault(); }
}

<article class="book-tile @(Model.Item.IsSold ? "sold" : Model.Item.Reserved ? "reserved" : "")" aria-labelledby="tile-title-@Model.Item.Id">
    <a class="cover" asp-page="/Book" asp-route-id="@Model.Item.Id" aria-labelledby="tile-title-@Model.Item.Id">
        <img src="@Model.FirstPhoto" alt="Okładka książki: @Model.Item.Book.Title" />
    </a>
    <footer>
        <div class="info">
            <a asp-page="/Book" asp-route-id="@Model.Item.Id" aria-labelledby="tile-title-@Model.Item.Id">
                <h2 id="tile-title-@Model.Item.Id">@Model.Item.Book.Title</h2>
            </a>

            <p>@Model.Item.Price zł</p>
            <p>
                <small>
                    @(Model.Item.User.School?.Name ?? "Nieznana szkoła")
                </small>
            </p>
        </div>
        <div class="actions">
            <div class="tag-row tag-row-subject">
                @if (Model.LinkFilters)
                {
                    <a asp-page="/Browse"
                       asp-route-subject="@Model.Item.Book.Subject.Name"
                       class='@(Model.Item.Book.Subject.Id == Model.Params.Subject?.Id ? "" : "outline") subject'
                       aria-label="Filtruj po przedmiocie: @(string.IsNullOrWhiteSpace(Model.Item.Book.Subject.Name) ? "Nieznany" : Model.Item.Book.Subject.Name)">
                        @(string.IsNullOrWhiteSpace(Model.Item.Book.Subject.Name) ? "Nieznany przedmiot" : Model.Item.Book.Subject.Name)
                    </a>
                }
                else
                {
                    <button type="button" class='@(Model.Item.Book.Subject.Id == Model.Params.Subject?.Id ? "" : "outline") subject'
                            data-filter-value="@Model.Item.Book.Subject.Name"
                            aria-pressed="@AriaHelpers.Bool(Model.Item.Book.Subject.Id == Model.Params.Subject?.Id)"
                            aria-label="Filtruj po przedmiocie: @(string.IsNullOrWhiteSpace(Model.Item.Book.Subject.Name) ? "Nieznany" : Model.Item.Book.Subject.Name)">
                        @(string.IsNullOrWhiteSpace(Model.Item.Book.Subject.Name) ? "Nieznany przedmiot" : Model.Item.Book.Subject.Name)
                    </button>
                }
            </div>
            @if (Model.Item.Book.Grades != null)
            {
                <div class="tag-row tag-row-grades">
                    @foreach (var grade in Model.Item.Book.Grades)
                    {
                        @if (Model.LinkFilters)
                        {
                            <a asp-page="/Browse"
                               asp-route-grade="@grade.GradeNumber"
                               class='@(Model.Params.Grades.Contains(grade) ? "" : "outline") grade'
                               aria-label="Filtruj po klasie: @grade.GradeNumber">
                                @DisplayGrade(grade.GradeNumber)
                            </a>
                        }
                        else
                        {
                            <button type="button" class='@(Model.Params.Grades.Contains(grade) ? "" : "outline") grade'
                                    data-filter-value="@grade.GradeNumber"
                                    aria-pressed="@AriaHelpers.Bool(Model.Params.Grades.Contains(grade))"
                                    aria-label="Filtruj po klasie: @grade.GradeNumber">
                                @DisplayGrade(grade.GradeNumber)
                            </button>
                        }
                    }
                </div>
            }
            @if (Model.Item.Book.Level != null)
            {
                <div class="tag-row tag-row-level">
                    @if (Model.LinkFilters)
                    {
                        <a asp-page="/Browse"
                           asp-route-level="@Model.Item.Book.Level.Name"
                           class='@(Model.Item.Book.Level == Model.Params.Level ? "" : "outline") level'
                           aria-label="Filtruj po poziomie: @Model.Item.Book.Level.Name">
                            @Model.Item.Book.Level.Name
                        </a>
                    }
                    else
                    {
                        <button type="button" class='@(Model.Item.Book.Level == Model.Params.Level ? "" : "outline") level'
                                data-filter-value="@Model.Item.Book.Level.Name"
                                aria-pressed="@AriaHelpers.Bool(Model.Item.Book.Level == Model.Params.Level)"
                                aria-label="Filtruj po poziomie: @Model.Item.Book.Level.Name">
                            @Model.Item.Book.Level.Name
                        </button>
                    }
                </div>
            }
        </div>
        <div class="fav">
            @if (UserId == Model.Item.User.Id)
            {
                <a class="outline" role="button"
                   aria-label="Edytuj ogłoszenie: @Model.Item.Book.Title"
                   title="Edytuj ogłoszenie"
                   href="/Edit/@Model.Item.Id">
                    <svg icon="pencil" variant="outline" aria-hidden="true"></svg>
                </a>
            }
            else
            {
                @await Html.PartialAsync("_FavoriteButton", new Profile.FavoritesModel.ButtonState
                (
                    Model.Item.Id,
                    await FavoritesManager.IsFavoriteAsync(UserId, Model.Item.Id),
                    false
                ))
            }
        </div>
    </footer>
</article>
