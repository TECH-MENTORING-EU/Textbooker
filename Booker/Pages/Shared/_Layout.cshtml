<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
    <link rel="shortcut icon" href="/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", false)
    <script src="~/lib/htmx/dist/htmx.min.js" asp-append-version="true"></script>

    @if (Context.Request.Path.StartsWithSegments("/Chat"))
    {
        <base href="/Chat/" />
    }
    else
    {
        <base href="~/" />
    }
</head>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<body class="page-shell @(Configuration.GetValue<bool>("testingPhase") ? "testing-phase-on" : null)">
    @if (Configuration.GetValue<bool>("testingPhase"))
    {
        <div class="testing-phase-badge"
             role="note"
             aria-label="Aplikacja ma wgrane dane testowe. Zachęcamy do załozenia konta, testowania i zglaszania usterek .">
            Aplikacja ma wgrane dane testowe. Zachęcamy do załozenia konta, testowania i zglaszania usterek .
        </div>
    }

    <a href="#main-content" class="skip-link">Przejdź do treści głównej</a>

    <header role="banner">
        <nav class="container-fluid" role="navigation" aria-label="Główna nawigacja" data-breakpoint="md">
            <ul>
                <li>
                    <a asp-area="" asp-page="/Index" aria-label="TextBooker - strona główna">
                        <img src="/img/logo-text.svg" alt="TextBooker" style="height: 2.25rem; vertical-align: baseline;">
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-page="/Index" aria-label="Strona główna" title="Strona główna">
                        <svg icon="home" variant="solid" aria-hidden="true" style="vertical-align: -0.2em; width: auto;"></svg>
                    </a>
                </li>
            </ul>
            @await Html.PartialAsync("_LoginPartial")
        </nav>
    </header>

    <main id="main-content" class="container @(ViewData["MainClass"])" tabindex="-1">
        @RenderBody()
    </main>

    <button class="float-right help-trigger"
            data-target="modal-example"
            onclick="openDialog(this)"
            aria-label="Pomoc" aria-haspopup="dialog"
            title="Pomoc">
        <svg icon="help" variant="outline" aria-hidden="true" style="width: 2rem; height: auto;"></svg>
    </button>

    <dialog id="modal-example" aria-labelledby="help-dialog-title">
        <article>
            <header>
                <button aria-label="Zamknij okno pomocy" rel="prev" onclick="closeDialog(this)" type="button"></button>
                <h5 id="help-dialog-title">Potrzebujesz pomocy? Skontaktuj się z nami! 💬</h5>
            </header>
            <p>
                Możemy pomóc na przykład w następujących przypadkach:
                <ul>
                    <li>Problemy z kontem, błędy lub pytania dotyczące działania aplikacji.</li>
                    <li>Chcesz zgłosić nieodpowiednie treści zamieszczone w aplikacji.</li>
                    <li>Propozycje i sugestie (wypełnij formularz feedback).</li>
                </ul>
                Bądź na bieżąco! Obserwuj nas w social mediach.
            </p>
            <footer>
                <div class="grid one-col" style="grid-template-columns: 1fr;">
                    <a href="https://www.facebook.com/profile.php?id=61578317232992" target="_blank" rel="noopener" role="button" class="outline contrast">
                        <svg icon="brand-facebook" variant="outline" aria-hidden="true"></svg>
                        Facebook
                    </a>
                    <a href="https://www.instagram.com/textbooker.pl/" target="_blank" rel="noopener" role="button" class="outline contrast" style="margin-left: 0;">
                        <svg icon="brand-instagram" variant="outline" aria-hidden="true"></svg>
                        Instagram
                    </a>
                    <a href="https://docs.google.com/forms/d/e/1FAIpQLSfWQrj0IlDS8a8y03Sy-_TFvcDP1FMCwWtoRbZxdKskqCgoxQ/viewform" target="_blank" rel="noopener" role="button" class="contrast" style="margin-left: 0;">
                        Formularz feedback
                    </a>
                    <a href="mailto:support@textbooker.pl" role="button" style="margin-left: 0;">
                        Kontakt: support@textbooker.pl
                    </a>
                </div>
            </footer>
        </article>
    </dialog>

    <footer class="container-fluid" role="contentinfo">
        <div class="container">
            <div class="footer-content">
                <a asp-area="" asp-page="/Index">
                    <img src="/img/logo-text.svg" alt="TextBooker" style="height: 1.75rem;">
                </a>
                <nav aria-label="Nawigacja dodatkowa">
                    <ul role="list">
                        <li><a asp-area="" asp-page="/Sitemap">Mapa strony</a></li>
                        <li><a asp-area="" asp-page="/Privacy">Polityka prywatności</a></li>
                        <li>
                            <button class="footer-help-link"
                                    type="button"
                                    data-target="modal-example"
                                    onclick="document.getElementById(this.dataset.target).showModal()">
                                Centrum pomocy
                            </button>
                        </li>
                        <li><a href="mailto:support@textbooker.pl">Kontakt</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </footer>

    <script src="~/js/validation/aspnet-validation.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
   
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
