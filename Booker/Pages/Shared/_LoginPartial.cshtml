@using Microsoft.AspNetCore.Identity
@using Booker.Data
@using Booker.Services
@using Booker.Utilities

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IChatThreadService ChatThreadService

<button type="button" id="hamburger-toggle" class="hamburger-trigger" aria-label="Otwórz menu konta" aria-controls="hamburger" aria-expanded="false">
    <svg icon="menu-2" aria-hidden="true"></svg>
</button>
<ul role="list" id="hamburger" aria-label="Menu konta">
@if (SignInManager.IsSignedIn(User))
{
    var userName = UserManager.GetUserName(User);
    var isMessagesEnabled = Configuration.GetValue<bool>("Features:MessagesEnabled");
    var unreadMessages = 0;
    if (isMessagesEnabled)
    {
        var currentUserId = UserManager.GetUserId(User).IntOrDefault();
        unreadMessages = await ChatThreadService.GetUnreadCountAsync(currentUserId, Context.RequestAborted);
    }
    <li>
        <details class="dropdown">
                <summary class="outline" style="border-color: transparent;" aria-expanded="false" aria-controls="account-actions" aria-label="Menu konta użytkownika @userName">Witaj @userName!</summary>
                <ul id="account-actions" aria-label="Akcje konta @userName">
                    <li><a asp-area="" asp-page="/Profile/Index">Profil</a></li>
                    <li><a asp-area="" asp-page="/Profile/Favorites">Ulubione</a></li>
                    @if (isMessagesEnabled)
                    {
                        // Plain href: asp-page would inherit the current DealId
                        // route value and point the menu at the open thread.
                        <li>
                            <a href="/Chat" class="messages-link">
                                <span>Wiadomości</span>
                                @if (unreadMessages > 0)
                                {
                                    <span class="menu-badge" aria-label="@unreadMessages nieprzeczytanych">@unreadMessages</span>
                                }
                            </a>
                        </li>
                    }
                    <li><a id="manage" asp-area="Identity" asp-page="/Account/Manage/Index">Ustawienia</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-area="Admin" asp-page="/Index">Panel administracyjny</a></li>
                    }
                    <li>
                        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                            <button id="logout" type="submit">Wyloguj</button>
                        </form>
                    </li>
                </ul>
        </details>
    </li>
    <li>
            <a role="button" asp-area="" asp-page="/Add" style="margin-top: 0;" aria-label="Dodaj nowe ogłoszenie">
            <svg icon="plus" aria-hidden="true" style="vertical-align: -0.4em;"></svg>
            <span>Dodaj ogłoszenie</span>
        </a>
    </li>
}
else
{
    <li>
        <a id="login" asp-area="Identity" asp-page="/Account/Login">Zaloguj się</a>
    </li>
    <li>
        <a id="register" role="button" asp-area="Identity" asp-page="/Account/Register">Zarejestruj się</a>
    </li>
}
</ul>
