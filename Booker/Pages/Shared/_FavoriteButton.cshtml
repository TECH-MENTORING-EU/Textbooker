@model Profile.FavoritesModel.ButtonState

@if (Model.IsFavorite && !Model.FullSize)
{
    <button type="button" class="outline" aria-label="Usuń z ulubionych" aria-pressed="true" title="Usuń z ulubionych"
            hx-post="@Url.Page("/Profile/Favorites", "Remove")"
            hx-vals='{"itemId" : @Model.Id, "fullsize" : false}' hx-swap="outerHTML" antiforgery>
        <svg icon="star" variant="filled" aria-hidden="true"></svg>
    </button>
}
else if (!Model.IsFavorite && !Model.FullSize)
{
    <button type="button" class="outline" aria-label="Dodaj do ulubionych" aria-pressed="false" title="Dodaj do ulubionych"
            hx-post="@Url.Page("/Profile/Favorites", "Add")"
            hx-vals='{"itemId" : @Model.Id, "fullsize" : false}' hx-swap="outerHTML" antiforgery>
        <svg icon="star" variant="outline" aria-hidden="true"></svg>
    </button>
}
else if (Model.IsFavorite && Model.FullSize)
{
    <button type="button" class="secondary" aria-pressed="true"
            hx-post="@Url.Page("/Profile/Favorites", "Remove")"
            hx-vals='{"itemId" : @Model.Id, "fullsize" : true}' hx-swap="outerHTML" antiforgery>
        Usuń z ulubionych
    </button>
}
else
{
    // (!Model.IsFavorite && Model.FullSize)
    <button type="button" aria-pressed="false"
            hx-post="@Url.Page("/Profile/Favorites", "Add")"
            hx-vals='{"itemId" : @Model.Id, "fullsize" : true}' hx-swap="outerHTML" antiforgery>
        Dodaj do ulubionych
    </button>
}
