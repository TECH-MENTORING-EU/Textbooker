@page
@model Booker.Pages.MessagesModel
@inject Booker.Services.PhotosManager PhotosManager
@{
    ViewData["Title"] = "Wiadomości";
}

<main>
    <h1>Wiadomości</h1>

    @if (Model.Threads.Count == 0)
    {
        <p class="secondary">Brak rozmów. Rozmowy zaczynasz z poziomu ogłoszenia - otwórz książkę i kliknij „Napisz do sprzedającego”.</p>
    }

    <section aria-label="Twoje rozmowy">
        <ul class="thread-list page-list">
            @foreach (var t in Model.Threads)
            {
                <li>
                    <a href="/Chat/@t.ChannelId">
                        <img class="thread-thumb"
                             src="@(string.IsNullOrEmpty(t.ItemPhoto) ? "/img/default-book.svg" : PhotosManager.GetPhotoUrl(t.ItemPhoto))"
                             alt="" />
                        <span class="thread-info">
                            <span class="name">@t.Title</span>
                            @if (t.IsItemThread)
                            {
                                <small class="about">z: @t.DisplayName</small>
                            }
                        </span>
                        <small class="when">ostatnia wiadomość: @t.LastMessageLocal</small>
                    </a>
                </li>
            }
        </ul>
    </section>
</main>
