@page
@model Booker.Pages.MessagesModel
@{
    ViewData["Title"] = "Wiadomości";
}

<main>
    <h1>Wiadomości</h1>

    @if (Model.Threads.Count == 0)
    {
        <p class="secondary">Brak rozmów. Rozmowy zaczynasz z poziomu ogłoszenia — otwórz książkę i kliknij „Napisz do sprzedającego”.</p>
    }

    <section aria-label="Twoje rozmowy">
        <ul class="thread-list">
            @foreach (var t in Model.Threads)
            {
                <li>
                    <a href="/Chat/@t.ChannelId">
                        <strong>@t.DisplayName</strong>
                        <small>ostatnia wiadomość: @t.LastMessageLocal</small>
                    </a>
                </li>
            }
        </ul>
    </section>
</main>
