@page
@model Booker.Pages.BookAddingModel
@inject Microsoft.AspNetCore.Identity.UserManager<Booker.Data.User> UserManager

@{
    ViewData["Title"] = "Dodaj ogłoszenie";
    const string include = "#add-form :not([name = '__RequestVerificationToken'])";

    // RODO — zadanie 05: bez żadnego włączonego kanału kontaktu ogłoszenie jest bezużyteczne
    // dla obu stron, więc ostrzegamy przed publikacją zamiast blokować ją po fakcie.
    var currentUser = await UserManager.GetUserAsync(User);
    var hasAnyContactChannel = currentUser != null && (
        currentUser.DisplayEmail
        || (currentUser.DisplayPhone && !string.IsNullOrEmpty(currentUser.PhoneNumber))
        || (currentUser.DisplayWhatsapp && !string.IsNullOrEmpty(currentUser.PhoneNumber))
        || (currentUser.DisplayMessenger && !string.IsNullOrEmpty(currentUser.FbMessenger))
        || (currentUser.DisplayInstagram && !string.IsNullOrEmpty(currentUser.Instagram))
    );
}

@if (!hasAnyContactChannel)
{
    <div role="alert">
        <strong>Nie masz włączonej żadnej formy kontaktu.</strong> Nikt nie będzie mógł się z Tobą
        skontaktować w sprawie tego ogłoszenia. Włącz przynajmniej jedną formę kontaktu w
        <a asp-area="Identity" asp-page="/Account/Manage/Index">ustawieniach profilu</a>.
    </div>
}

<h1 id="add-heading">Nowe ogłoszenie:</h1>
<form method="post" enctype="multipart/form-data" id="add-form" aria-labelledby="add-heading" hx-on:submit="if (!this.dataset.inSummary) showSummary(event)" hx-on:image-upload-state="toggleFormSubmitState(this, event.detail.busy)">
    <div class="grid">
        <section>
            <label for="add-image">Prześlij zdjęcia swojej książki:</label>
            <input type="file" asp-for="Input.Images" accept="image/*" multiple hx-on:change="handleImageUpload(this)" id="add-image" aria-describedby="Input_Images-error imageErrorMsg">
            <small>
                <span asp-validation-for="Input.Images" id="Input_Images-error" role="alert"></span>
                <span id="imageErrorMsg" role="alert"></span>
                <span id="imageProcessingMsg" role="status" aria-live="polite"></span>
            </small>
            <div class="image-preview-container" role="group" aria-label="Podgląd zdjęć książki"></div>
            <div asp-validation-summary="ModelOnly" role="alert" aria-live="assertive"></div>
        </section>

        <section>
            <span hx-get="?handler=Params&firstLoad=true" hx-trigger="load" hx-include="@include" hx-swap="delete" aria-hidden="true"></span>

            <label asp-for="Input.Title">Tytuł książki:</label>
            <select asp-for="Input.Title" asp-items="Model.Books" aria-describedby="Input_Title-help">
                <option value="">Wybierz książkę</option>
            </select>
            <small id="Input_Title-help">
                <span asp-validation-for="Input.Title" role="alert"></span><br>
                Nie widzisz swojej książki? Wybierz opcję "inna" i opisz ją poniżej.
            </small>

            <label asp-for='Input.Subject'>Przedmiot:</label>
            <select asp-for='Input.Subject' asp-items="Model.Subjects" aria-describedby="Input_Subject-error">
                <option value="">Wybierz przedmiot</option>
            </select>
            <small><span asp-validation-for="Input.Subject" id="Input_Subject-error" role="alert"></span></small>

            <label asp-for='Input.Grade'>Klasa:</label>
            <select asp-for='Input.Grade' asp-items="Model.Grades" aria-describedby="Input_Grade-error">
                <option value="">Wybierz klasę</option>
            </select>
            <small><span asp-validation-for="Input.Grade" id="Input_Grade-error" role="alert"></span></small>

            <label asp-for='Input.Level'>Poziom:</label>
            <select asp-for='Input.Level' asp-items="Model.Levels" aria-describedby="Input_Level-error">
                <option value="">Wybierz poziom</option>
            </select>
            <small><span asp-validation-for="Input.Level" id="Input_Level-error" role="alert"></span></small>

            <label asp-for="Input.Description">Opis ogłoszenia:</label>
            <textarea asp-for="Input.Description" rows="4" maxlength="200" placeholder="Tutaj przekaż ważne informacje dla kupującego np. potencjalne miejsce spotkania..." aria-describedby="Input_Description-counter"></textarea>
            <small id="Input_Description-counter"><span class="char-count">0 / 200</span></small>

            <label asp-for="Input.State">Stan książki:</label>
            <textarea asp-for="Input.State" rows="3" maxlength="40" placeholder="Opisz stan książki…" aria-describedby="Input_State-error Input_State-counter"></textarea>
            <small>
                <span asp-validation-for="Input.State" id="Input_State-error" role="alert"></span>
                <span class="char-count" id="Input_State-counter" style="text-align: right;">0 / 40</span>
            </small>

            <label asp-for="Input.Price">Cena:</label>
            <input asp-for="Input.Price" placeholder="PLN" aria-describedby="Input_Price-error">
            <small><span asp-validation-for="Input.Price" id="Input_Price-error" role="alert"></span></small>

            <button type="submit">Dalej</button>
        </section>
    </div>
</form>

<dialog id="summaryModal" aria-labelledby="summary-title">
    <article>
        <header>
            @* <a href="#close" aria-label="Close" class="close" data-target="summaryModal" onclick="return false;"></a> *@
            <button type="button" aria-label="Close" rel="prev" hx-on:click="this.closest('dialog').close(); document.getElementById('add-form').dataset.inSummary = '';"></button>
            <h2>Podsumowanie ogłoszenia</h2>
        </header>
        <div>
            <img id="summaryImage" src="" alt="">
        </div>
        <p><strong>Tytuł książki:</strong> <span id="summaryTitle"></span></p>
        <p><strong>Przedmiot:</strong> <span id="summarySubject"></span></p>
        <p><strong>Klasa:</strong> <span id="summaryGrade"></span></p>
        <p><strong>Poziom:</strong> <span id="summaryLevel"></span></p>
        <p><strong>Opis:</strong> <span id="summaryDescription"></span></p>
        <p><strong>Stan:</strong> <span id="summaryState"></span></p>
        <p><strong>Cena:</strong> <span id="summaryPrice"></span></p>
        <footer>
            <button id="confirmAddBtn" form="add-form" type="submit">Potwierdź i dodaj ogłoszenie</button>
        </footer>
    </article>
</dialog>

@section Scripts {
    <script src="~/js/add-page.js" asp-append-version="true"></script>
}

