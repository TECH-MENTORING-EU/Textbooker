@page
@model IndexModel
@{
    ViewData["Title"] = "TextBooker";
}

<h1 class="visually-hidden">TextBooker - ogłoszenia z podręcznikami</h1>

<section class="filter" aria-labelledby="filter-heading">
    <h2 id="filter-heading" class="visually-hidden">Filtry i wyszukiwanie</h2>
    <form novalidate
          hx-get="/"
          hx-trigger="submit, input changed delay:500ms, change"
          hx-target=".grid-gallery"
          hx-indicator="#ind"
          hx-push-url="true"
          role="search"
          class="filter-search"
          aria-label="Wyszukiwanie podręczników">
        <div class="search-row">
            <label for="search" class="visually-hidden">Szukana fraza</label>
            <input type="search" id="search" name="search" asp-for="Input.Search" placeholder="Wyszukaj..." data-val="false"
                   aria-describedby="search-hint"
                   hx-on:focus="document.getElementById('search-hint').hidden = false;"
                   hx-on:blur="document.getElementById('search-hint').hidden = true;"
                   hx-on:keydown="document.getElementById('search-hint').hidden = true;" />

            <button type="button" id="filterToggle" class="filter-toggle" aria-expanded="false" aria-controls="filterPanel">
                <svg icon="adjustments-horizontal" aria-hidden="true" style="vertical-align: -0.15em;"></svg>
                Filtry
            </button>
        </div>

        <small id="search-hint" hidden>Szukasz książki do przedmiotu zawodowego lub innej rzadko występującej? Wpisz "inna".</small>

        <div id="filterPanel" class="filter-panel" hidden>
            <div class="grid">
                <label for="grade" class="visually-hidden">Klasa</label>
                <select name="grade" id="grade" asp-for="Input.Grade" asp-items="Model?.Grades" data-val="false">
                    <option value="">Wszystkie klasy</option>
                </select>

                <label for="subject" class="visually-hidden">Przedmiot</label>
                <select name="subject" id="subject" asp-for="Input.Subject" asp-items="Model?.Subjects" data-val="false">
                    <option value="">Wszystkie przedmioty</option>
                </select>

                <label for="level" class="visually-hidden">Poziom</label>
                <select name="level" id="level" asp-for="Input.Level" asp-items="Model?.Levels">
                    <option value="">Wszystkie poziomy</option>
                </select>

                <label for="minPrice" class="visually-hidden">Cena minimalna</label>
                <input type="number" name="minPrice" id="minPrice" asp-for="Input.MinPrice" placeholder="Cena min." data-val="false" />

                <label for="maxPrice" class="visually-hidden">Cena maksymalna</label>
                <input type="number" name="maxPrice" id="maxPrice" asp-for="Input.MaxPrice" placeholder="Cena max." data-val="false" />
            </div>

            <button type="reset" class="secondary" hx-on:click="this.form.reset(); this.form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));">Wyczyść filtry</button>
            <button type="button" id="mobileFilterSubmit">Zatwierdź filtry</button>
        </div>
    </form>
</section>

<section class="grid-gallery" aria-live="polite" aria-label="Wyniki wyszukiwania">
    <vc:item-gallery item-ids="@Model.ItemIds" parameters="@Model.Params" />
</section>

<section>
    <div class="htmx-indicator" id="ind" role="status" aria-live="polite"></div>
</section>

<script>
    function setFilter(name, value, enable) {
        const elem = document.querySelector(`[name="${name}"]`);
        if (elem) {
            elem.value = enable ? value : "";
            elem.form.requestSubmit();
        }
    }

    htmx.onLoad(function(content) {
        content.querySelectorAll('button.subject, button.grade, button.level').forEach(button => {
            // Sync aria-pressed to current state from outline class on render.
            button.setAttribute("aria-pressed", !button.classList.contains("outline"));

            button.addEventListener('click', function() {
                const name = this.classList.contains('subject') ? 'subject' : this.classList.contains('grade') ? 'grade' : 'level';
                const value = this.dataset.filterValue;
                this.classList.toggle('outline');
                const active = !this.classList.contains('outline');
                this.setAttribute("aria-pressed", active);
                setFilter(name, value, active);
            });
        });
    });

    const filterToggle = document.getElementById('filterToggle');
    const filterPanel = document.getElementById('filterPanel');
    filterToggle.addEventListener('click', function() {
        const isOpen = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !isOpen);
        filterPanel.hidden = isOpen;
    });

    document.getElementById('mobileFilterSubmit').addEventListener('click', function() {
        filterToggle.setAttribute('aria-expanded', 'false');
        filterPanel.hidden = true;
        filterToggle.focus();
    });
</script>
