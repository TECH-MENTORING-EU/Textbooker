@model Profile.IndexModel.UserModel
@using Profile
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var profilePhotosEnabled = Configuration.GetValue<bool>("Features:ProfilePhotosEnabled");
    var defaultAvatarPath = Configuration.GetValue<string>("Features:DefaultProfilePicturePath") ?? "/img/default-profile-picture.jpg";
    var profilePhotoUrl = profilePhotosEnabled && !string.IsNullOrWhiteSpace(Model.RequestUser.Photo)
        ? Model.RequestUser.Photo
        : defaultAvatarPath;
}

<section class="profile-heading" aria-label="Nagłówek profilu użytkownika">
    <img src="@profilePhotoUrl"
         alt="Zdjęcie profilowe użytkownika: @Model.RequestUser.UserName" />
    <div class="profile-heading-body">
        <hgroup>
            <h1>@Model.RequestUser.UserName</h1>
            <p> @{ /* TODO: Add user profile description */ } </p>
        </hgroup>
        @if (Model.IsCurrentUser)
        {
            @if (!string.IsNullOrEmpty(Model.SchoolName))
            {
                <p>
                    <small>
                        Twoja szkoła: <strong>@Model.SchoolName</strong> (nie można jej zmienić — zmiana
                        wymaga założenia nowego konta)
                    </small>
                </p>
            }
            <a role="button" class="outline" href="/Identity/Account/Manage">Ustawienia konta</a>
        }
        else if (User.Identity?.IsAuthenticated == true && Model.RequestUser.DisplaySchool && !string.IsNullOrEmpty(Model.SchoolName))
        {
            <p><small>Szkoła: @Model.SchoolName</small></p>
        }
    </div>
</section>

<h2>Kontakt</h2>
<section aria-label="Dane kontaktowe użytkownika">
    @if (User.Identity?.IsAuthenticated != true)
    {
        @("Zaloguj się, aby zobaczyć dane kontaktowe użytkownika.")
    }
    else if (!Model.IsCurrentUser && !Model.HasActiveListing)
    {
        @("Ten użytkownik nie ma obecnie żadnych aktywnych ogłoszeń, dlatego jego dane kontaktowe nie są udostępniane.")
    }
    else
    {
        <partial name="_ContactDetails" for="RequestUser" />
    }
</section>

<nav aria-label="Sekcje profilu użytkownika">
    <ul role="list">
        @if (Model.IsCurrentUser)
        {
            <li><a aria-current="@AriaHelpers.CurrentOrNull(ManageNavPages.IndexNavClass(ViewContext))" id="profile" asp-page="./Index">Ogłoszenia</a></li>
            <li><a aria-current="@AriaHelpers.CurrentOrNull(ManageNavPages.FavoritesNavClass(ViewContext))" id="favorites" asp-page="./Favorites">Ulubione</a></li>
        }
        else
        {
            <li><a aria-current="@AriaHelpers.CurrentOrNull(ManageNavPages.IndexNavClass(ViewContext))" id="profile" asp-page="./Index" asp-route-id="@Model.RequestUser.Id">Ogłoszenia</a></li>
            @if (Model.RequestUser.IsVisible && Model.RequestUser.AreFavoritesPublic)
            {
                <li><a aria-current="@AriaHelpers.CurrentOrNull(ManageNavPages.FavoritesNavClass(ViewContext))" id="favorites" asp-page="./Favorites" asp-route-id="@Model.RequestUser.Id">Ulubione</a></li>
            }
        }
    </ul>
</nav>
