@page "{id:int}"
@model Booker.Pages.EditModel
@inject Booker.Services.PhotosManager PhotosManager
@{
    ViewData["Title"] = "Edytuj ogłoszenie";
    // RODO: scoped to the fields that affect the select options - Description/State/Price hold
    // user-entered text (here, the real saved listing content) and must never ride along in
    // this GET's query string.
    const string include = "#Input_Title, #Input_Subject, #Input_Grade, #Input_Level";
}

<article aria-labelledby="edit-heading">
    <h1 id="edit-heading">Edytuj ogłoszenie:</h1>

    @if (Model.ItemToEdit == null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            Ogłoszenie nie zostało znalezione lub nie masz uprawnień do jego edycji.
        </div>
    }
    else
    {
        <form method="post" enctype="multipart/form-data" id="edit-form" class="upload-form" data-in-summary="" hx-on:submit="event.preventDefault(); showConfirmSaveModal(event);" hx-on:image-upload-state="toggleFormSubmitState(this, event.detail.busy)">
            <div class="grid">
                <section>
                    <p role="note">
                        <strong>Nie wysyłaj zdjęć, na których widać osoby, twarze, adresy, plan lekcji,
                        legitymację ani inne dane osobowe.</strong> Sfotografuj sam podręcznik.
                    </p>
                    <label asp-for="Input.Images">Zmień zdjęcia książki (opcjonalnie):</label>
                    <input type="file" asp-for="Input.Images" accept="image/*" multiple hx-on:change="handleImageUpload(this)" aria-describedby="Input_Images-error imageErrorMsg">
                    <small>
                        <span asp-validation-for="Input.Images" id="Input_Images-error" role="alert"></span>
                        <span id="imageErrorMsg" role="alert"></span>
                        <span id="imageProcessingMsg" role="status" aria-live="polite"></span>
                    </small>

                    <div class="image-preview-container" role="group" aria-label="Podgląd zapisanych zdjęć książki">
                        @foreach (var (img, index) in (Model.ItemToEdit.Photo ?? "")
                       .Split(';', StringSplitOptions.RemoveEmptyEntries)
                       .Select((val, i) => (val, i)))
                        {
                            <img src="@PhotosManager.GetPhotoUrl(img.Trim())"
                                 alt="Zdjęcie książki @(index + 1)"
                                 class="book-image-preview @(index == 0 ? "main" : "")" />
                        }
                    </div>


                    <div asp-validation-summary="ModelOnly" role="alert" aria-live="assertive"></div>
                </section>

                <section>
                    <span hx-get="?handler=Params&firstLoad=true" hx-trigger="load" hx-include="@include" hx-swap="delete" aria-hidden="true"></span>

                    <label asp-for="Input.Title">Tytuł książki:</label>
                    <select asp-for="Input.Title" asp-items="Model.Books" aria-describedby="Input_Title-help"></select>
                    <small id="Input_Title-help">
                        <span asp-validation-for="Input.Title" role="alert"></span><br>
                        Nie widzisz swojej książki? Wybierz opcję "inna" i opisz ją poniżej.
                    </small>

                    <label asp-for='Input.Subject'>Przedmiot:</label>
                    <select asp-for='Input.Subject' asp-items="Model.Subjects" aria-describedby="Input_Subject-error"></select>
                    <small><span asp-validation-for="Input.Subject" id="Input_Subject-error" role="alert"></span></small>

                    <label asp-for='Input.Grade'>Klasa:</label>
                    <select asp-for='Input.Grade' asp-items="Model.Grades" aria-describedby="Input_Grade-error"></select>
                    <small><span asp-validation-for="Input.Grade" id="Input_Grade-error" role="alert"></span></small>

                    <label asp-for='Input.Level'>Poziom:</label>
                    <select asp-for='Input.Level' asp-items="Model.Levels" aria-describedby="Input_Level-error"></select>
                    <small><span asp-validation-for="Input.Level" id="Input_Level-error" role="alert"></span></small>

                    <label asp-for="Input.Description">Opis ogłoszenia:</label>
                    <p role="note">
                        <small>
                            Nie wpisuj tu swojego numeru telefonu, e-maila ani innych danych o sobie —
                            od kontaktu jest przycisk przy ogłoszeniu. Wszystko, co tu wpiszesz, zobaczy
                            każda osoba odwiedzająca ogłoszenie, także niezalogowana.
                        </small>
                    </p>
                    <textarea asp-for="Input.Description" rows="4" maxlength="200" placeholder="Tutaj przekaż ważne informacje dla kupującego np. potencjalne miejsce spotkania..." aria-describedby="Input_Description-error Input_Description-counter"></textarea>
                    <small id="Input_Description-counter">
                        <span asp-validation-for="Input.Description" id="Input_Description-error" role="alert"></span>
                        <span class="char-count">0 / 200</span>
                    </small>
                    @if (Model.ShowSensitiveContentWarning)
                    {
                        <fieldset>
                            <label for="confirmSensitiveDescriptionCheckbox" class="form-check-label">
                                <input type="checkbox" id="confirmSensitiveDescriptionCheckbox" asp-for="Input.ConfirmSensitiveDescription">
                                Rozumiem, że mój opis może zawierać dane kontaktowe, i mimo to chcę zapisać to ogłoszenie.
                            </label>
                        </fieldset>
                    }

                    <label asp-for="Input.State">Stan książki:</label>
                    <textarea asp-for="Input.State" rows="3" maxlength="40" placeholder="Opisz stan książki…" aria-describedby="Input_State-error Input_State-counter"></textarea>
                    <small><span asp-validation-for="Input.State" id="Input_State-error" role="alert"></span><span class="char-count" id="Input_State-counter" style="text-align:right;">0 / 40</span></small>


                    <label asp-for="Input.Price">Cena:</label>
                    <input asp-for="Input.Price" placeholder="PLN" aria-describedby="Input_Price-error">
                    <small><span asp-validation-for="Input.Price" id="Input_Price-error" role="alert"></span></small>


                    <div class="form-check">
                        <input asp-for="Input.Reserved" type="checkbox" />
                        <label asp-for="Input.Reserved" class="inline">Zarezerwowane</label>
                    </div>

                    <div class="grid">
                        <button type="submit" role="button">Zapisz zmiany</button>
                        <button type="button" role="button" class="secondary" onclick="showConfirmDeleteModal(@Model.ItemToEdit.Id)" aria-label="Usuń to ogłoszenie">Usuń ogłoszenie</button>
                    </div>
                </section>
            </div>
        </form>
    }
</article>

<dialog id="confirmSaveModal" aria-labelledby="confirm-save-title">
    <article>
        <h2 id="confirm-save-title">Potwierdź zapis</h2>
        <p>Czy na pewno chcesz zapisać zmiany w tym ogłoszeniu?</p>
        <footer>
            <button type="button" onclick="this.closest('dialog').close();" class="secondary">Anuluj</button>
            <button type="button" onclick="document.getElementById('edit-form').submit();">Zapisz</button>
        </footer>
    </article>
</dialog>

<dialog id="confirmDeleteModal" aria-labelledby="confirm-delete-title">
    <article>
        <h2 id="confirm-delete-title">Potwierdź usunięcie</h2>
        <p>Czy na pewno chcesz trwale usunąć to ogłoszenie? Tej operacji nie można cofnąć.</p>
        <footer>
            <div class="grid">
                <button type="button" onclick="this.closest('dialog').close();" class="secondary">Anuluj</button>
                <form method="post" asp-page-handler="Delete" id="delete-form-confirm" style="display: contents;">
                    <input type="hidden" name="ItemId" id="deleteItemId" />
                    <button type="submit" role="button">Usuń</button>
                </form>
            </div>
        </footer>
    </article>
</dialog>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize character counters
            document.querySelectorAll('textarea').forEach(ta => {
                ta.addEventListener("input", updateCharCount);
                ta.dispatchEvent(new Event("input"));
            });
        });

        function showConfirmSaveModal(event) {
            document.getElementById('confirmSaveModal').showModal();
        }

        function showConfirmDeleteModal(itemId) {
            document.getElementById('deleteItemId').value = itemId;
            document.getElementById('confirmDeleteModal').showModal();
        }
    </script>
}
