@page "{id:int}"
@model Booker.Pages.BookModel

@{
    ViewData["Title"] = $"{Model.BookItem.Book.Title} - TextBooker";

    var images = Model.Photos;
    var mainImage = images.FirstOrDefault();
}

<article class="book-display" aria-labelledby="book-title">

    <section class="image" aria-label="Zdjęcia książki">
        @if (images.Any())
        {
            <img src="@mainImage" alt="Główne zdjęcie książki: @Model.BookItem.Book.Title" class="main-book-photo" />

            <div class="thumbnail-images" role="group" aria-label="Wybierz zdjęcie do podglądu">
                @foreach (var (img, idx) in images.Select((value, i) => (value, i)))
                {
                    var isActive = img == mainImage;
                    <img src="@img"
                         alt="Zdjęcie książki @(idx + 1) z @images.Count()"
                         class="thumbnail-book-photo"
                         tabindex="0"
                         role="button"
                         aria-pressed="@AriaHelpers.Bool(isActive)"
                         aria-label="Pokaż zdjęcie @(idx + 1)"
                         data-index="@idx" />
                }
            </div>
        }
    </section>

    <section class="data">
        <h1 id="book-title">@Model.BookItem.Book.Title</h1>
        <p>
            <small>
                Dodane: @(Booker.Pages.BookModel.FormatDateWithSpecialCases(Model.BookItem.CreatedAt))
                @if (Model.BookItem.UpdatedAt != null)
                {
                    <br />
                    <text>Edytowane: @(Booker.Pages.BookModel.FormatDateWithSpecialCases(Model.BookItem.UpdatedAt.Value))</text>
                }
                @if (Model.IsCurrentUserOwner)
                {
                    <br />
                    <text>Wyświetleń: @Model.ViewCount</text>
                }
            </small>
        </p>
        <p><strong aria-label="Cena: @Model.BookItem.Price.ToString("C")">@Model.BookItem.Price.ToString("C")</strong></p>
        @if (Model.BookItem.Reserved)
        {
            <p role="status"><strong>Ten przedmiot jest obecnie zarezerwowany.</strong></p>
        }

        <ul>
            <li>
                Klasa: @String.Join(", ",
                Model.BookItem.Book.Grades.Select(g => g.GradeNumber).ToList() ?? new() { "nieznana" })
            </li>
            <li>Przedmiot: @Model.BookItem.Book.Subject.Name</li>
            <li>Zakres: @Model.BookItem.Book.Level.Name</li>
            <li>Stan: @(Model.BookItem.State ?? "Nieznany stan")</li>
        </ul>
    </section>

    <section class="actions" aria-label="Akcje dla tego ogłoszenia">
        @if (Model.IsCurrentUserOwner)
        {
            <a asp-page="/Edit" asp-route-id="@Model.BookItem.Id" role="button" style="margin-inline-end: 1em;">Edytuj ogłoszenie</a>
            
            <input type="checkbox" checked="@Model.BookItem.Reserved" antiforgery
                hx-post="?handler=Reserve" hx-swap="outerHTML" name="reserve" id="reserve-cb" value="true" />
            <label for="reserve-cb">Oznacz jako zarezerwowane</label>
        }
        else
        {
            @await Html.PartialAsync("_FavoriteButton", new Profile.FavoritesModel.ButtonState(Model.BookItem.Id, Model.IsFavorite, true))
            <button type="button" hx-get="?handler=Email" hx-swap="outerHTML">Zapytaj o przedmiot</button>
        }
    </section>

    <section class="description">
        <h2>Opis</h2>
        <p>@Model.BookItem.Description</p>
    </section>

    <section class="seller" aria-label="Informacje o sprzedającym">
        <h2>Sprzedaje</h2>
        <div>
            <img src="@(string.IsNullOrWhiteSpace(Model.BookItem.User.Photo) ? "/img/default-profile-picture.jpg" : Model.BookItem.User.Photo)"
                 alt="Zdjęcie profilowe sprzedającego: @Model.BookItem.User.UserName" />
            <div>
                @Model.BookItem.User.UserName<br />
                @(Model.BookItem.User.School?.Name ?? "Bez szkoły")<br />
                <a href="/Profile/@Model.BookItem.UserId" role="button" class="outline">Więcej od tego użytkownika</a>
            </div>
        </div>
    </section>

</article>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const mainImg = document.querySelector(".main-book-photo");
        const thumbnails = document.querySelectorAll(".thumbnail-book-photo");

        thumbnails.forEach(th => {
            var activate = () => {
                if (!mainImg) return;
                mainImg.src = th.src;
                thumbnails.forEach(other => other.setAttribute("aria-pressed", other === th));
                mainImg.setAttribute("alt", `Główne zdjęcie książki: ${document.getElementById("book-title")?.textContent?.trim() ?? ""}`);
            };

            th.addEventListener("click", activate);
            th.addEventListener("keydown", function (event) {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    activate();
                }
            });
        });
    });
</script>
