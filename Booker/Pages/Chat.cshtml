@page "{DealId?}"
@model Booker.Pages.ChatModel
@inject Booker.Services.PhotosManager PhotosManager
@{
    ViewData["Title"] = "Czat";
}

<div class="chat-layout">
    <aside class="chat-sidebar" aria-label="Twoje rozmowy">
        <h2>Wiadomości</h2>
        @if (Model.Threads.Count == 0)
        {
            <p class="chat-sidebar-empty">
                Brak rozmów. Rozmowy zaczynasz z poziomu ogłoszenia - otwórz książkę i kliknij „Napisz do sprzedającego”.
            </p>
        }
        else
        {
            <ul class="thread-list">
                @foreach (var t in Model.Threads)
                {
                    <li>
                        <a href="/Chat/@t.ChannelId"
                           class="@(t.ChannelId == Model.DealId ? "active" : null)"
                           aria-current="@(t.ChannelId == Model.DealId ? "page" : null)"
                           hx-get="/Chat?handler=Thread&dealId=@t.ChannelId"
                           hx-target="#conversation" hx-swap="outerHTML"
                           hx-push-url="/Chat/@t.ChannelId"
                           hx-on::after-request="chatSelectThread(this)">
                            <img class="thread-thumb"
                                 src="@(string.IsNullOrEmpty(t.ItemPhoto) ? "/img/default-book.svg" : PhotosManager.GetPhotoUrl(t.ItemPhoto))"
                                 alt="" />
                            <span class="thread-info">
                                <span class="name">@(t.ItemTitle ?? t.DisplayName)</span>
                                @if (t.ItemTitle != null)
                                {
                                    <small class="about">z: @t.DisplayName</small>
                                }
                            </span>
                            <small class="when">@PolishTime.ToLocal(t.LastMessageUtc).ToString("dd.MM HH:mm")</small>
                        </a>
                    </li>
                }
            </ul>
        }
    </aside>

    <partial name="_Conversation" model="Model" />
</div>

<script src="~/js/chat.js" asp-append-version="true" defer></script>
